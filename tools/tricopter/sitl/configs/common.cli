# Shared by genuine stock and modified builds. Synthetic airframe, not FC export.
mixer TRI
feature -GPS
feature -TELEMETRY
feature RX_UDP
feature AIRMODE
serial UART2 1 115200 57600 0 115200
map AETR1234
servo 5 1100 1700 1509 100 -1
set tri_unarmed_servo = ON
set motor_pwm_protocol = PWM
set min_command = 1000
set motor_idle = 500
set max_throttle = 2000
set motor_output_reordering = 0,1,2,3,4,5,6,7
set align_board_yaw = 0
set gyro_calib_duration = 50
set acc_calibration = 0,0,0,1
set small_angle = 45
set failsafe_procedure = DROP
set failsafe_delay = 5
set debug_mode = NONE
aux 0 0 0 1700 2100 0 0
aux 1 1 1 1700 2100 0 0
profile 0
set simplified_pids_mode = OFF
# Gamepad-friendly ANGLE tilt limit; retain the aircraft's existing PID gains.
set angle_limit = 30
set p_roll = 35
set i_roll = 16
set d_roll = 15
set f_roll = 47
set p_pitch = 35
set i_pitch = 17
set d_pitch = 15
set f_pitch = 49
set p_yaw = 50
set i_yaw = 10
set d_yaw = 20
set f_yaw = 47
rateprofile 0
