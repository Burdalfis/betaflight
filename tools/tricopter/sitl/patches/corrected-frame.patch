diff --git a/src/platform/SIMULATOR/sitl_gyro.h b/src/platform/SIMULATOR/sitl_gyro.h
--- a/src/platform/SIMULATOR/sitl_gyro.h
+++ b/src/platform/SIMULATOR/sitl_gyro.h
@@ -46,3 +46,12 @@
     *pitch = -rpy[1];
     *yaw   =  gazeboBridge ? rpy[2] : -rpy[2];
 }
+
+// The Gazebo rate PID keeps CW-positive yaw, while the NWU/FLU quaternion
+// estimator and ANGLE coordinated-turn geometry use a right-handed Up axis.
+// Convert only those attitude consumers; never rewrite the rate PID sample.
+// Legacy simulator bridges already use their existing attitude convention.
+static inline double sitlGyroYawForAttitude(double pidYaw, bool gazeboBridge)
+{
+    return gazeboBridge ? -pidYaw : pidYaw;
+}
